#!/bin/sh
task=local-validation
if [ "$1" = --task ]; then task=$2; shift 2; fi
name=$(printf %s "$task" | sed 's/[^A-Za-z0-9_-]/-/g; s/--*/-/g; s/^-//; s/-$//')
[ -n "$name" ] || { echo "local-browser: workspace inválido: $task" >&2; exit 2; }
if [ ${#name} -gt 32 ]; then
  name="$(printf %s "$name" | tail -c 20 | sed 's/^-*//')-$(printf %s "$name" | sha256sum | cut -c1-8)"
fi
profile="$HOME/.local/state/local-browser/$name"
mkdir -p "$profile" || exit 1

export PATH="$HOME/.local/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/.local/share/browser-libs/root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export AGENT_BROWSER_ARGS="${AGENT_BROWSER_ARGS:---force-prefers-reduced-motion}"
exec agent-browser --session "lb-$name" --profile "$profile" "$@"
